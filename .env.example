# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual connection string, e.g.:
# mongodb+srv://<username>:<password>@cluster.mongodb.net/subscription_mgmt?retryWrites=true&w=majority
# If the URI omits a database name, the server uses subscription_management.
MONGODB_URI=mongodb://localhost:27017/subscription_management

# JSON Web Token Secret Key
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173

# DNS Override (optional)
# Set this if your local DNS resolver cannot resolve MongoDB Atlas SRV records.
# Use Google Public DNS or another reliable resolver. Leave unset to use the system default.
# DNS_SERVERS=8.8.8.8,8.8.4.4
